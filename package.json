{
  "name": "dsh-codex-bridge",
  "version": "0.1.0",
  "description": "Imports Codex Desktop conversations into DeepSeek Harness and keeps skills in sync both ways.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "codex",
    "deepseek-harness",
    "skills"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
